# Copia este archivo a `.env` y llena los valores para desarrollo local.
# NUNCA commitear `.env` con secretos reales (ver 01-architecture §7).

# --- Core ---
ENV=development
DATABASE_URL=postgresql+psycopg://elogistics:elogistics@localhost:5432/elogistics

# --- Auth / JWT ---
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

# --- Facturama (sandbox) ---
# 🔴 INFO REQUERIDA (Vlad): credenciales del sandbox de Facturama.
FACTURAMA_ENV=sandbox
FACTURAMA_USER=
FACTURAMA_PASSWORD=

# --- Cloudflare R2 ---
# 🔴 INFO REQUERIDA (Vlad): bucket y llaves de R2.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=elogistics

# --- Resend ---
# 🔴 INFO REQUERIDA (Vlad): API key de Resend y correo remitente verificado.
RESEND_API_KEY=
EMAIL_FROM="Elogistics <facturacion@dominio.mx>"

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Emisor (persona física) — constantes fiscales ---
# 🔴 INFO REQUERIDA (Vlad): confirmar antes de timbrar en real (04-facturacion-cfdi §1).
EMISOR_RFC=
EMISOR_NOMBRE=
EMISOR_REGIMEN_FISCAL=612
EMISOR_LUGAR_EXPEDICION=

# --- Seed admin inicial (H0.2) ---
# 🔴 INFO REQUERIDA (Vlad): usuario(s) admin real(es) para el seed.
SEED_ADMIN_NOMBRE=Admin Elogistics
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
